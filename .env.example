# Copia a .env para desarrollo local (no subir .env a GitHub)

# Secreto JWT — obligatorio en producción (Render: generar valor aleatorio)
GANTT_JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# URL pública de la app (para enlaces de recuperación de contraseña)
GANTT_APP_URL=http://localhost:5173

# Base de datos (opcional)
# Local SQLite por defecto. En Render usa PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host/dbname
# GANTT_DB_PATH=./gantt_produccion.db
# Ruta al Excel local para importación automática (botón "Importar Gantt local")
# GANTT_LOCAL_XLSX_PATH=/Users/andresdiaz/Desktop/Production gantt2.xlsx

# CORS — orígenes separados por coma (solo si frontend y API están en dominios distintos)
# GANTT_CORS_ORIGINS=https://tu-app.onrender.com

# SMTP opcional — recuperación de contraseña por email
# GANTT_SMTP_HOST=smtp.ejemplo.com
# GANTT_SMTP_PORT=587
# GANTT_SMTP_USER=
# GANTT_SMTP_PASSWORD=
# GANTT_SMTP_FROM=noreply@tu-dominio.com

# Frontend (solo si API está en otro dominio)
# VITE_API_URL=https://tu-api.onrender.com/api
